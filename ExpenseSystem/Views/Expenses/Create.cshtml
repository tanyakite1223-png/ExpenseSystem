@using ExpenseSystem.Models
@model ExpenseWithDetailsViewModel

<link rel="stylesheet" href="~/css/expenses.css" />

<h2 class="page-title">新增單據</h2>

<div class="form-container">
    <form asp-action="Create" method="post">

        <div class="section-title">主檔</div>

        <div class="field-row">
            <label asp-for="Expense.Title"></label>
            <input asp-for="Expense.Title" />
            <span asp-validation-for="Expense.Title" class="validation-error"></span>
        </div>
        <div class="field-row">
            <label asp-for="Expense.Description"></label>
            <input asp-for="Expense.Description" />
            <span asp-validation-for="Expense.Description" class="validation-error"></span>
        </div>
        <input asp-for="Expense.Status" value="0" type="hidden" />

        <div class="section-title" style="margin-top: 24px;">費用明細</div>
        <button type="button" class="btn-add-row btn-addDetail">＋ 新增費用明細</button>

        <table class="detail-table">
            <thead>
                <tr>
                    <th>專案</th>
                    <th>發票類型</th>
                    <th>費用類別</th>
                    <th>費用日期</th>
                    <th>發票號碼</th>
                    <th>金額</th>
                    <th>說明</th>
                    <th>商店名稱</th>
                    <th></th>
                </tr>
            </thead>
            <tbody class="detail">
                @for (int i = 0; i < ViewBag.expenseDetails; i++)
                {
                    <tr class="detail-row">
                        <td>
                            <select asp-for="ExpenseDetails[i].ProjectId" asp-items="@ViewBag.projectSelect"></select>
                        </td>
                        <td>
                            <select asp-for="ExpenseDetails[i].ReceiptType" asp-items="@ViewBag.Receipt"></select>
                        </td>
                        <td>
                            <select asp-for="ExpenseDetails[i].Category" asp-items="@ViewBag.Category"></select>
                        </td>
                        <td>
                            <input asp-for="ExpenseDetails[i].ExpenseDate" type="date" />
                            <span asp-validation-for="ExpenseDetails[i].ExpenseDate" class="validation-error"></span>
                        </td>
                        <td>
                            <input asp-for="ExpenseDetails[i].InvoiceNumber" />
                            <span asp-validation-for="ExpenseDetails[i].InvoiceNumber" class="validation-error"></span>
                        </td>
                        <td>
                            <input asp-for="ExpenseDetails[i].Amount" />
                            <span asp-validation-for="ExpenseDetails[i].Amount" class="validation-error"></span>
                        </td>
                        <td>
                            <input asp-for="ExpenseDetails[i].Description" />
                        </td>
                        <td>
                            <input asp-for="ExpenseDetails[i].StoreName" />
                        </td>
                        <td>
                            <button type="button" class="btn-remove-row deleteRow">－ 移除</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="form-actions">
            <button type="submit" class="btn-primary">新 增</button>
            <a asp-action="Index" class="btn-secondary">取 消</a>
        </div>

    </form>
</div>

<script>
    const addDetailRowBtn = document.querySelector('.btn-addDetail');
    addDetailRowBtn.addEventListener('click', function () {
        const rowCount = document.querySelectorAll('.detail-row').length;

        const project = document.querySelector('select[name^="ExpenseDetails"][name$=".ProjectId"]');
        const receipt = document.querySelector('select[name^="ExpenseDetails"][name$=".ReceiptType"]');
        const category = document.querySelector('select[name^="ExpenseDetails"][name$=".Category"]');

        const newRowHtml = `<tr class="detail-row">
            <td><select name="ExpenseDetails[${rowCount}].ProjectId">${project ? project.innerHTML : ''}</select></td>
            <td><select name="ExpenseDetails[${rowCount}].ReceiptType">${receipt ? receipt.innerHTML : ''}</select></td>
            <td><select name="ExpenseDetails[${rowCount}].Category">${category ? category.innerHTML : ''}</select></td>
            <td><input name="ExpenseDetails[${rowCount}].ExpenseDate" type="date" /></td>
            <td><input name="ExpenseDetails[${rowCount}].InvoiceNumber" /></td>
            <td><input name="ExpenseDetails[${rowCount}].Amount" /></td>
            <td><input name="ExpenseDetails[${rowCount}].Description" /></td>
            <td><input name="ExpenseDetails[${rowCount}].StoreName" /></td>
            <td><button type="button" class="btn-remove-row deleteRow">－ 移除</button></td>
        </tr>`;

        document.querySelector('.detail').insertAdjacentHTML('beforeend', newRowHtml);
    });

    document.querySelector('.detail').addEventListener('click', function (e) {
        if (e.target.classList.contains('deleteRow')) {
            const row = e.target.closest('.detail-row');
            if (row) row.remove();
        }
    });
</script>
