@using ExpenseSystem.Models
@using Microsoft.AspNetCore.Identity
@model List<Expense>

<link rel="stylesheet" href="~/css/expenses.css" />

<div class="header-container">
    <h2>報銷列表</h2>
</div>

<div class="action-bar">
    @if (!User.IsInRole(role: "Manager"))
    {
        <a asp-action="Create" class="btn-create">＋ 新增報銷</a>
    }

    <a asp-controller="Login" asp-action="Logout" class="btn-logout">登出系統</a>
</div>

<div class="table-container">
    <table class="expense-table">
        <thead>
            <tr>
                <th style="width: 60px;">編號</th>
                <th style="width: 140px;">項目</th>
                <th style="width: 100px;">總計金額</th>
                <th style="width: 200px;">申請日期</th>
                <th style="width: 250px;">說明</th>
                @if (User.IsInRole(role: "Manager"))
                {
                    <th style="width: 150px;">申請人</th>
                }
                <th style="width: 100px;">狀態</th>
                <th style="width: 250px;">功能</th>
                <th style="width: 300px;">拒絕原因</th>
            </tr>
        </thead>
        <tbody>
            @{
                int itemNumber = 1;
            }

            @foreach (var item in Model)
            {
                <tr>
                    <td style="text-align: center;">@(itemNumber++)</td>
                    <td><strong>@item.Title</strong></td>
                    <td style="text-align: left; color: #e67e22; font-weight: 500;">$@item.TotalAmount.ToString(format:
                                                                                                                                                                                                                                                                                       "N0")
                    </td>
                    <td style="text-align: left;">@(item.CreatedAt.ToString(format: "yyyy-MM-dd"))</td>
                    <td>@item.Description</td>
                    @if (User.IsInRole(role: "Manager"))
                    {
                        <td>@item.ApplicantId</td>
                    }
                    <td style="text-align: center;">@EnumExtensions.GetDisplayName(@item.Status)</td>
                    <td style="text-align: center;">
                        @if (!User.IsInRole("Manager"))
                        {
                            <form method="post" asp-action="Submitted" asp-route-id="@item.ExpenseId">
                                <button type="submit" class="SubmitButton"
                                        data-statusBtn="@EnumExtensions.GetDisplayName(@item.Status)" data-id="@item.ExpenseId"
                                        onclick="return confirm('確定要送審？')">送審</button>
                            </form>

                            <form method="get" asp-action="Edit" asp-route-id="@item.ExpenseId">
                                <button type="submit" class="EditBtn"
                                        data-statusBtn="@EnumExtensions.GetDisplayName(@item.Status)">修改</button>
                            </form>
                        }


                        @if (User.IsInRole("Manager"))
                        {
                            <form method="get" asp-action="Review" asp-route-id="@item.ExpenseId">
                                <button type="submit" data-statusBtn="@EnumExtensions.GetDisplayName(@item.Status)">修改</button>
                            </form>

                            <form method="get" asp-action="Delete" asp-route-id="@item.ExpenseId">
                                <button type="submit">刪除</button>
                            </form>
                        }
                    </td>
                    <td style="color: #c0392b;">@item.RejectionReason</td>
                </tr>
            }

        </div>
    </tbody>
</table>
<div class="pagination">
    <a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)"
       class="@(ViewBag.CurrentPage <= 1 ? "disabled" : "")"
       style="margin-right: 15px;">
        上一頁
    </a>

    <span style="font-weight: 500;">目前在第 @ViewBag.CurrentPage / @ViewBag.TotalPages 頁</span>

    <a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)"
       class="@(ViewBag.CurrentPage >= ViewBag.TotalPages ? "disabled" : "")"
       style="margin-left: 15px;">
        下一頁
    </a>
</div>
</div>

<script>
    const buttons = document.querySelectorAll(".SubmitButton, .EditBtn");

    buttons.forEach(function (btn) {
        if (btn.dataset.statusbtn === "審核中" || btn.dataset.statusbtn === "已核准" || btn.dataset.statusbtn === "已拒絕") {
            btn.style.display = 'none';
        }

        if (btn.dataset.statusbtn.trim() === "退／補件" && btn.classList.contains("SubmitButton")) {
            btn.style.display = 'none';
        }

    });
</script>