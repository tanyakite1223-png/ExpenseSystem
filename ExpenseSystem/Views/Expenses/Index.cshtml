@using ExpenseSystem.Models
@model List<Expense>

<h2>報銷列表</h2>
<a asp-action="Create">新增</a>
<a asp-controller="Login" asp-action="Logout">登出</a>
<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>項目：</th>
            <th>金額：</th>
            <th>日期：</th>
            <th>說明：</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ExpenseId</td>
                <td>@item.Title</td>
                <td>@item.Amount</td>
                <td>@item.ExpenseDate</td>
                <td>@item.Description</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ExpenseId">修改</a>
                    <a asp-action="Delete" asp-route-id="@item.ExpenseId">刪除</a>
                </td>
            </tr>

        }
    </tbody>
</table>