@using ExpenseSystem.Models
@model Expense

<link rel="stylesheet" href="~/css/expenses.css" />

<h2 class="page-title">修改單據</h2>

<div class="form-container">
    <form asp-action="Edit" method="post">

        <div class="section-title">主檔</div>
        <input asp-for="Status" type="hidden" />
        <input asp-for="ExpenseId" type="hidden" />

        <div class="field-row">
            <label asp-for="Title"></label>
            <input asp-for="Title" readonly />
            <span asp-validation-for="Title" class="validation-error"></span>
        </div>
        <div class="field-row">
            <label asp-for="Description"></label>
            <input asp-for="Description" readonly />
            <span asp-validation-for="Description" class="validation-error"></span>
        </div>
        <div style="margin-bottom: 20px;">
            <button type="button" class="btn-unlock" id="unlockMainBtn">修 改</button>
        </div>

        <div class="section-title">費用明細</div>
        <button type="button" class="btn-add-row btn-addDetail">＋ 新增費用明細</button>

        <table class="detail-table">
            <thead>
                <tr>
                    <th></th>
                    <th>專案</th>
                    <th>發票類型</th>
                    <th>費用類別</th>
                    <th>費用日期</th>
                    <th>發票號碼</th>
                    <th>金額</th>
                    <th>說明</th>
                    <th>商店名稱</th>
                    <th>功能</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="detailTableBody">
                @for (int i = 0; i < (Model.ExpenseDetails?.Count ?? 0); i++)
                {
                    <tr class="detail-row">
                        <td>
                            <input asp-for="ExpenseDetails[i].ExpenseDetailId" type="hidden" />
                            <input asp-for="ExpenseDetails[i].ExpenseId" type="hidden" />
                        </td>
                        <td>
                            <select asp-for="ExpenseDetails[i].ProjectId" asp-items="@ViewBag.projectSelect"
                                    style="pointer-events: none; background-color: #e9ecef;"></select>
                        </td>
                        <td>
                            <select asp-for="ExpenseDetails[i].ReceiptType" asp-items="@ViewBag.Receipt"
                                    style="pointer-events: none; background-color: #e9ecef;"></select>
                        </td>
                        <td>
                            <select asp-for="ExpenseDetails[i].Category" asp-items="@ViewBag.Category"
                                    style="pointer-events: none; background-color: #e9ecef;"></select>
                        </td>
                        <td>
                            <input asp-for="ExpenseDetails[i].ExpenseDate" type="date" readonly />
                            <span asp-validation-for="ExpenseDetails[i].ExpenseDate" class="validation-error"></span>
                        </td>
                        <td>
                            <input asp-for="ExpenseDetails[i].InvoiceNumber" readonly />
                            <span asp-validation-for="ExpenseDetails[i].InvoiceNumber" class="validation-error"></span>
                        </td>
                        <td>
                            <input asp-for="ExpenseDetails[i].Amount" readonly />
                            <span asp-validation-for="ExpenseDetails[i].Amount" class="validation-error"></span>
                        </td>
                        <td>
                            <input asp-for="ExpenseDetails[i].Description" readonly />
                            <span asp-validation-for="ExpenseDetails[i].Description" class="validation-error"></span>
                        </td>
                        <td>
                            <input asp-for="ExpenseDetails[i].StoreName" readonly />
                            <span asp-validation-for="ExpenseDetails[i].StoreName" class="validation-error"></span>
                        </td>
                        <td>
                            <button type="button" class="btn-unlock btn-edit">修改</button>
                        </td>
                        <td>
                            <button type="button" class="btn-remove-row deleteRow">－ 移除</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="form-actions">
            <button type="submit" class="btn-primary">存 檔</button>
            <a asp-action="Index" class="btn-secondary">取 消</a>
        </div>

    </form>
</div>

<script>
    document.getElementById('unlockMainBtn').addEventListener('click', function () {
        const inputs = document.querySelectorAll('#expenseTableBody input:not([type="hidden"])');
        inputs.forEach(input => input.removeAttribute('readonly'));
    });

    document.getElementById('detailTableBody').addEventListener('click', function (e) {
        const row = e.target.closest('tr');

        if (e.target.classList.contains('btn-edit')) {
            row.querySelectorAll('input:not([type="hidden"])').forEach(input => input.removeAttribute('readonly'));
            row.querySelectorAll('select').forEach(select => {
                select.style.pointerEvents = '';
                select.style.backgroundColor = '#ffffff';
            });
        }

        if (e.target.classList.contains('deleteRow') && row) {
            row.remove();
        }
    });

    document.querySelector('.btn-addDetail').addEventListener('click', function () {
        const rowCount = document.querySelectorAll('.detail-row').length;
        const project = document.querySelector('select[name^="ExpenseDetails"][name$=".ProjectId"]');
        const receipt = document.querySelector('select[name^="ExpenseDetails"][name$=".ReceiptType"]');
        const category = document.querySelector('select[name^="ExpenseDetails"][name$=".Category"]');

        const newRowHtml = `<tr class="detail-row">
            <td>
                <input name="ExpenseDetails[${rowCount}].ExpenseDetailId" type="hidden" value="0" />
                <input name="ExpenseDetails[${rowCount}].ExpenseId" type="hidden" value="@Model.ExpenseId" />
            </td>
            <td><select name="ExpenseDetails[${rowCount}].ProjectId">${project ? project.innerHTML : ''}</select></td>
            <td><select name="ExpenseDetails[${rowCount}].ReceiptType">${receipt ? receipt.innerHTML : ''}</select></td>
            <td><select name="ExpenseDetails[${rowCount}].Category">${category ? category.innerHTML : ''}</select></td>
            <td><input name="ExpenseDetails[${rowCount}].ExpenseDate" type="date" /></td>
            <td><input name="ExpenseDetails[${rowCount}].InvoiceNumber" /></td>
            <td><input name="ExpenseDetails[${rowCount}].Amount" /></td>
            <td><input name="ExpenseDetails[${rowCount}].Description" /></td>
            <td><input name="ExpenseDetails[${rowCount}].StoreName" /></td>
            <td><button type="button" class="btn-unlock btn-edit">修改</button></td>
            <td><button type="button" class="btn-remove-row deleteRow">－ 移除</button></td>
        </tr>`;

        document.getElementById('detailTableBody').insertAdjacentHTML('beforeend', newRowHtml);
    });
</script>
