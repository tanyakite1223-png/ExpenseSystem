@using ExpenseSystem.Models
@model Expense

<h2>審核單據</h2>
<form asp-action="Review" method="POST">
    <input asp-for="ExpenseId" type="hidden" />
    <label asp-for="ApplicantId">申請人</label>
    <input asp-for="ApplicantId" value="@ViewBag.username" readonly />

    <label asp-for="Title"></label>
    <input asp-for="Title" readonly />

    <label asp-for="Description"></label>
    <input asp-for="Description" readonly />

    <label asp-for="Status">審核狀態</label>
    <select asp-for="Status" asp-items="@ViewBag.selectItem" id="statusSelect">
    </select>

    <div id="RejectionDiv">
        <label asp-for="RejectionReason"></label>
        <input asp-for="RejectionReason" id="RejectionReason" />
        <span asp-validation-for="RejectionReason"></span>
    </div>
    <div asp-validation-summary="ModelOnly"></div>

    <div>
        <button type="submit">修改</button>
        <a asp-action="Index">取消</a>
    </div>
</form>

<table>
    <thead>
        <tr>
            <th colspan="9">費用明細</th>
        </tr>
        <th>專案</th>
        <th>發票類型</th>
        <th>費用類別</th>
        <th>費用日期</th>
        <th>發票號碼</th>
        <th>金額</th>
        <th>說明</th>
        <th>商店名稱</th>
    </tr>
</thead>
<tbody id="detailTableBody"> @for (int i = 0; i < (Model.ExpenseDetails?.Count ?? 0); i++)
    {
        <tr>

            <td>
                <input type="text" value="@Model.ExpenseDetails[i].Project?.ProjectName" readonly />
            </td>
            <td>
                <input type="text" value="@Model.ExpenseDetails[i].ReceiptType.GetDisplayName()" readonly />
            </td>
            <td>
                <input type="text" value="@Model.ExpenseDetails[i].Category.GetDisplayName()" readonly />
            </td>
            <td>
                <input type="text" value="@Model.ExpenseDetails[i].ExpenseDate" type="date" readonly />
            </td>
            <td>
                <input type="text" value="@Model.ExpenseDetails[i].InvoiceNumber" readonly />
            </td>
            <td>
                <input type="text" value="@Model.ExpenseDetails[i].Amount" readonly />
            </td>
            <td>
                <input type="text" value="@Model.ExpenseDetails[i].Description" readonly />
            </td>
            <td>
                <input type="text" value="@Model.ExpenseDetails[i].StoreName" readonly />
            </td>
        </tr>
    }
</tbody>
</table>


<script>
    let statusSelect = document.getElementById('statusSelect');
    const RejectionDiv = document.getElementById('RejectionDiv');
    const RejectionInput = document.getElementById('RejectionReason');

    function toggleRejectionDiv() {
        if (!statusSelect) return;

        if (statusSelect.value === 'Rejected') {
            RejectionDiv.style.display = 'block';
            RejectionInput.disabled = false;
        }
        else {
            RejectionDiv.style.display = 'none';
            RejectionInput.disabled = true;
        }
    }

    if (statusSelect) {
        statusSelect.addEventListener('change', toggleRejectionDiv);
        toggleRejectionDiv();
    }
</script>