@using ExpenseSystem.Models
@model Expense

<link rel="stylesheet" href="~/css/expenses.css" />

<h2 class="page-title">審核單據</h2>

<div class="form-container">
    <form asp-action="Review" method="POST">
        <input asp-for="ExpenseId" type="hidden" />

        <div class="section-title">主檔</div>

        <div class="field-row">
            <label asp-for="ApplicantId">申請人</label>
            <input asp-for="ApplicantId" value="@ViewBag.username" readonly />
        </div>
        <div class="field-row">
            <label asp-for="Title"></label>
            <input asp-for="Title" readonly />
        </div>
        <div class="field-row">
            <label asp-for="Description"></label>
            <input asp-for="Description" readonly />
        </div>
        <div class="field-row">
            <label asp-for="Status">審核狀態</label>
            <select asp-for="Status" asp-items="@ViewBag.selectItem" id="statusSelect"></select>
        </div>

        <div id="RejectionDiv" class="field-row">
            <label asp-for="RejectionReason"></label>
            <input asp-for="RejectionReason" id="RejectionReason" />
            <span asp-validation-for="RejectionReason" class="validation-error"></span>
        </div>

        <div asp-validation-summary="ModelOnly" style="color: #e74c3c; font-size: 13px; margin-bottom: 12px;"></div>

        <div class="section-title" style="margin-top: 24px;">費用明細</div>

        <table class="detail-table">
            <thead>
                <tr>
                    <th>專案</th>
                    <th>發票類型</th>
                    <th>費用類別</th>
                    <th>費用日期</th>
                    <th>發票號碼</th>
                    <th>金額</th>
                    <th>說明</th>
                    <th>商店名稱</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < (Model.ExpenseDetails?.Count ?? 0); i++)
                {
                    <tr>
                        <td><input type="text" value="@Model.ExpenseDetails[i].Project?.ProjectName" readonly /></td>
                        <td><input type="text" value="@Model.ExpenseDetails[i].ReceiptType.GetDisplayName()" readonly /></td>
                        <td><input type="text" value="@Model.ExpenseDetails[i].Category.GetDisplayName()" readonly /></td>
                        <td><input type="text" value="@Model.ExpenseDetails[i].ExpenseDate" readonly /></td>
                        <td><input type="text" value="@Model.ExpenseDetails[i].InvoiceNumber" readonly /></td>
                        <td><input type="text" value="@Model.ExpenseDetails[i].Amount" readonly /></td>
                        <td><input type="text" value="@Model.ExpenseDetails[i].Description" readonly /></td>
                        <td><input type="text" value="@Model.ExpenseDetails[i].StoreName" readonly /></td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="form-actions">
            <button type="submit" class="btn-primary">送出審核</button>
            <a asp-action="Index" class="btn-secondary">取 消</a>
        </div>

    </form>
</div>

<script>
    const statusSelect = document.getElementById('statusSelect');
    const RejectionDiv = document.getElementById('RejectionDiv');
    const RejectionInput = document.getElementById('RejectionReason');

    function toggleRejectionDiv() {
        if (!statusSelect) return;
        if (statusSelect.value === 'Rejected') {
            RejectionDiv.style.display = 'flex';
            RejectionInput.disabled = false;
        } else {
            RejectionDiv.style.display = 'none';
            RejectionInput.disabled = true;
        }
    }

    if (statusSelect) {
        statusSelect.addEventListener('change', toggleRejectionDiv);
        toggleRejectionDiv();
    }
</script>
