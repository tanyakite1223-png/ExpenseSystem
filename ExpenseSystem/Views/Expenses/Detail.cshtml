@using System.Security.Claims
@using ExpenseSystem.Models
@model Expense

<link rel="stylesheet" href="~/css/expenses.css" />

<h2 class="page-title">單據明細</h2>

<div class="form-container">

    <div class="section-title">主檔</div>

    <div class="field-row">
        <label>標題</label>
        <input value="@Model.Title" readonly />
    </div>
    <div class="field-row">
        <label>總金額</label>
        <input value="$@Model.TotalAmount.ToString("N0")" readonly />
    </div>
    <div class="field-row">
        <label>描述內容</label>
        <input value="@Model.Description" readonly />
    </div>

    <div class="section-title" style="margin-top: 24px;">費用明細</div>

    <table class="detail-table">
        <thead>
            <tr>
                <th>項次</th>
                <th>單據類型</th>
                <th>費用類型</th>
                <th>交易日期</th>
                <th>發票編號</th>
                <th>商店名稱</th>
                <th>金額</th>
                <th>描述內容</th>
                <th>專案名稱</th>
            </tr>
        </thead>
        <tbody>
            @{
                int itemNumber = 1;
            }
            @foreach (var detail in Model.ExpenseDetails)
            {
                <tr>
                    <td style="text-align: center;">@(itemNumber++)</td>
                    <td><input type="text" value="@EnumExtensions.GetDisplayName(detail.ReceiptType)" readonly /></td>
                    <td><input type="text" value="@EnumExtensions.GetDisplayName(detail.Category)" readonly /></td>
                    <td><input type="text" value="@detail.ExpenseDate" readonly /></td>
                    <td><input type="text" value="@detail.InvoiceNumber" readonly /></td>
                    <td><input type="text" value="@detail.StoreName" readonly /></td>
                    <td><input type="text" value="@detail.Amount" readonly /></td>
                    <td><input type="text" value="@detail.Description" readonly /></td>
                    <td><input type="text" value="@detail.Project?.ProjectName" readonly /></td>
                </tr>
            }
        </tbody>
    </table>

    <div class="form-actions" style="margin-top: 24px;">
        @{
            string? userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
        }
        @if (Model.ApplicantId == userId && (Model.Status == ExpenseStatus.Draft || Model.Status == ExpenseStatus.Returned))
        {
            <a asp-action="Edit" asp-route-id="@Model.ExpenseId" class="btn-primary" style="text-decoration: none;">修 改</a>
        }
        <a asp-action="Index" class="btn-secondary">回列表</a>
    </div>

</div>
