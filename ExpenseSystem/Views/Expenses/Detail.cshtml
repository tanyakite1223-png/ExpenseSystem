@model Expense

<h2>新增單據</h2>
<form asp-action="Create" method="post">
    <div>
        <h3>主檔</h3>
        <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
            <tr style="border-bottom: 1px solid #ddd;">
                <td style="padding: 8px; font-weight: bold; width: 15%;"><label asp-for="Title"></label></td>
                <td style="padding: 8px;"><input asp-for="Title" style="width: 100%;" /></td>
            </tr>
            <tr style="border-bottom: 1px solid #ddd;">
                <td style="padding: 8px; font-weight: bold;"><label asp-for="Amount"></label></td>
                <td style="padding: 8px;"><input asp-for="Amount" style="width: 100%;" /></td>
            </tr>
            <tr style="border-bottom: 1px solid #ddd;">
                <td style="padding: 8px; font-weight: bold;"><label asp-for="ExpenseDate"></label></td>
                <td style="padding: 8px;"><input asp-for="ExpenseDate" type="date" style="width: 100%;" /></td>
            </tr>
            <tr style="border-bottom: 1px solid #ddd;">
                <td style="padding: 8px; font-weight: bold;"><label asp-for="Description"></label></td>
                <td style="padding: 8px;"><input asp-for="Description" style="width: 100%;" /></td>
            </tr>
        </table>

        <input asp-for="Status" value="0" type="hidden" />

        <h3>費用明細</h3>
        <table style="width: 100%; border-collapse: collapse; border: 1px solid #ccc; text-align: left;">
            <tr style="background-color: #f2f2f2; border-bottom: 2px solid #ccc;">
                <th style="padding: 10px; border: 1px solid #ddd;">項次</th>
                <th style="padding: 10px; border: 1px solid #ddd;">單據類型</th>
                <th style="padding: 10px; border: 1px solid #ddd;">費用類型</th>
                <th style="padding: 10px; border: 1px solid #ddd;">交易日期</th>
                <th style="padding: 10px; border: 1px solid #ddd;">發票編號</th>
                <th style="padding: 10px; border: 1px solid #ddd;">商店名稱</th>
                <th style="padding: 10px; border: 1px solid #ddd;">金額</th>
                <th style="padding: 10px; border: 1px solid #ddd;">描述內容</th>
                <th style="padding: 10px; border: 1px solid #ddd;">專案名稱</th>
            </tr>

            @{
                int itemNumber = 1;
            }
            @foreach (var detail in Model.ExpenseDetails)
            {
                <tr style="border-bottom: 1px solid #ddd;">
                    <td style="padding: 8px; border: 1px solid #ddd;">@(itemNumber++)</td>
                    <td style="padding: 8px; border: 1px solid #ddd;">@EnumExtensions.GetDisplayName(detail.ReceiptType)
                    </td>
                    <td style="padding: 8px; border: 1px solid #ddd;">@EnumExtensions.GetDisplayName(detail.Category)</td>
                    <td style="padding: 8px; border: 1px solid #ddd;">@detail.ExpenseDate</td>
                    <td style="padding: 8px; border: 1px solid #ddd;">@detail.InvoiceNumber</td>
                    <td style="padding: 8px; border: 1px solid #ddd;">@detail.StoreName</td>
                    <td style="padding: 8px; border: 1px solid #ddd;">@detail.Amount</td>
                    <td style="padding: 8px; border: 1px solid #ddd;">@detail.Description</td>
                    <td style="padding: 8px; border: 1px solid #ddd;">@detail.Project?.ProjectName</td>
                </tr>
            }
        </table>
    </div>
</form>