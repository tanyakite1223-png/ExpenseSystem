@using System.Security.Claims
@model Expense

<h2>新增成功</h2>

<h3>主檔</h3>
<table>
    <tr>
        <td><label asp-for="Title"></label></td>
        <td><input asp-for="Title" /></td>
    </tr>
    <tr>
        <td>總金額</td>
        <td>$@Model.TotalAmount.ToString("N0")</td>
    </tr>
    <tr>
        <td><label asp-for="Description"></label></td>
        <td><input asp-for="Description" /></td>
    </tr>
</table>


<h3>費用明細</h3>
<table>
    <thead>
        <tr>
            <th>項次</th>
            <th>單據類型</th>
            <th>費用類型</th>
            <th>交易日期</th>
            <th>發票編號</th>
            <th>商店名稱</th>
            <th>金額</th>
            <th>描述內容</th>
            <th>專案名稱</th>
        </tr>
    </thead>
    <tbody>
        @{
            int itemNumber = 1;
        }
        @foreach (var detail in Model.ExpenseDetails)
        {
            <tr>
                <td>@(itemNumber++)</td>
                <td>@EnumExtensions.GetDisplayName(detail.ReceiptType)</td>
                <td>@EnumExtensions.GetDisplayName(detail.Category)</td>
                <td>@detail.ExpenseDate</td>
                <td>@detail.InvoiceNumber</td>
                <td>@detail.StoreName</td>
                <td>@detail.Amount</td>
                <td>@detail.Description</td>
                <td>@detail.Project?.ProjectName</td>
            </tr>
        }
    </tbody>
</table>

<div>
    @{
        string? userId = User.FindFirstValue(System.Security.Claims.ClaimTypes.NameIdentifier);
    }

    @if (Model.ApplicantId == userId && (ExpenseStatus.Draft == Model.Status || ExpenseStatus.Returned == Model.Status))
    {
        <a asp-action="Edit" asp-route-id="@Model.ExpenseId">修 改</a>
    }

    <a asp-action="Index">回到首頁</a>
</div>