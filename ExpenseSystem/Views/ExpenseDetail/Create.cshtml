@using ExpenseSystem.Models
@model ExpenseDetail

<h2>新增明細單據</h2>
<form asp-action="Create" method="post">
    <div>
        <input asp-for="ExpenseId" type="hidden" />
        <label asp-for="Category"></label>
        <select asp-for="Category" asp-items="@ViewBag.categorySelect" id="categorySelect"></select>
        <span asp-validation-for="Category"></span>
        <p></p>
        <label asp-for="ExpenseDate"></label>
        <input asp-for="ExpenseDate" />
        <span asp-validation-for="ExpenseDate"></span>
        <p></p>
        <label asp-for="StoreName"></label>
        <input asp-for="StoreName" />
        <span asp-validation-for="StoreName"></span>
        <p></p>
        <label asp-for="InvoiceNumber"></label>
        <input asp-for="InvoiceNumber" />
        <span asp-validation-for="InvoiceNumber"></span>
        <p></p>
        <label asp-for="Amount"></label>
        <input asp-for="Amount" />
        <span asp-validation-for="Amount"></span>
        <p></p>
        <label asp-for="ProjectId"></label>
        <select asp-for="ProjectId" asp-items="@ViewBag.projectSelect" id="projectSelect">
        </select>
        <p></p>
        <label asp-for="Description"></label>
        <input asp-for="Description" />
        <span asp-validation-for="Description"></span>
        <p></p>

    </div>
    <!-- 按鈕並排組 -->
    <div>
        <button type="submit">新增</button>
        <button asp-action="Index">取消</button>
    </div>

</form>